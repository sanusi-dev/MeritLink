  "bugs": {
    "url": "https://github.com/sanusi-dev/MeritLink/issues"
  },
  "homepage": "https://github.com/sanusi-dev/MeritLink#readme",
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "htmx.org": "^2.0.10",
    "sweetalert2": "^11.26.24"
  }
}
